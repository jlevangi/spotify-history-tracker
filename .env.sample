SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
# Must match the redirect URI in your Spotify app settings.
# Use http://<docker-host-ip>:8888/callback for headless/Docker usage.
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback
# Port for the OAuth callback server (must match the port in SPOTIPY_REDIRECT_URI)
SPOTIFY_CALLBACK_PORT=8888
# Seconds to wait for user to complete browser auth (default: 300)
# SPOTIFY_AUTH_TIMEOUT=300
# Docker Hub image name/tag for build+push (example: yourname/spotify-history-tracker:latest)
IMAGE_NAME=
# Host path for output files (must be an absolute Linux path when running in WSL)
# Example local path: /mnt/c/Users/pierc/spotify-output
# Example mounted NAS path: /mnt/nas/my_spotify_data
OUTPUT_HOST_DIR=/mnt/c/Users/pierc/spotify-output
